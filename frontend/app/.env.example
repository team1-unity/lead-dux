# Copy this file to .env and fill in real values — .env itself is
# gitignored, this template is the only part that's tracked.

# MapTiler API key (map tiles/styles — MapLibre GL JS map rendering, see
# frontend/template/mapStyle.js) — restrict it to your domain(s) in the
# MapTiler Cloud dashboard once you have a real domain. Free account:
# https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=

# Geoapify API key (address autocomplete/geocoding — PlaceCombobox.jsx) —
# restrict it to your domain(s) under Security in the Geoapify MyProjects
# dashboard once you have a real domain. Free account, no card required:
# https://myprojects.geoapify.com/
VITE_GEOAPIFY_KEY=
