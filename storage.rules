rules_version = '2';

// Quest photo submissions — proof of quest participation (see
// submit_quest_photo/approve_photo_submission/reject_photo_submission in
// functions/main.py). Path is photoSubmissions/{questId}_{uid}/{fileName},
// the same {questId}_{uid} composite id _attendance_doc_id already uses.
//
// The read rule checks the blob's own custom metadata (orgId/isDefault)
// rather than looking up the matching photoSubmissions Firestore doc —
// that doc doesn't exist yet at upload time (submit_quest_photo creates it
// AFTER re-verifying the upload), and reading a blob's own metadata avoids
// a cross-service rules dependency entirely. submit_quest_photo patches
// this metadata via the Admin SDK (bypasses these rules) once it has
// verified the quest's real orgId/isDefault server-side.
service firebase.storage {
  match /b/{bucket}/o {
    // Pulls the uid back out of a {questId}_{uid} composite id by taking
    // the LAST '_'-separated segment, not a fixed index — a quest id can
    // itself contain underscores (e.g. seed data uses slugs like
    // "seed-jc-community-kitchen-near_full"), but a Firebase Auth uid
    // never does, so the final segment is always the uid regardless of
    // how many underscores came before it.
    function submitterUid(questIdUid) {
      return questIdUid.split('_')[questIdUid.split('_').size() - 1];
    }

    match /photoSubmissions/{questIdUid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == submitterUid(questIdUid) ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'organization' && resource != null &&
         request.auth.uid == resource.metadata.orgId)
      );
      // Create-only — a resubmission after rejection always uploads to a
      // fresh {timestampMillis}.{ext} path (see QuestPhotoSubmission.jsx),
      // never overwriting an existing object, so update isn't needed.
      allow create: if request.auth != null
        && request.auth.uid == submitterUid(questIdUid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }

    // An org's own public "Community Photos" gallery (see
    // add_organization_photo/remove_organization_photo in functions/main.py
    // and OrganizationProfile.jsx). Readable by anyone signed in, same as
    // the organizations/{uid} Firestore doc itself — writable only by the
    // owning org, and even then only to add (never overwrite) a fresh
    // {timestampMillis}.{ext} path; removing one goes through the Cloud
    // Function instead (it deletes the Firestore array entry and the
    // Storage object together, via the Admin SDK, which bypasses this rule
    // entirely — that's why delete is false here, not because it's
    // unreachable).
    match /orgPhotos/{orgId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.role == 'organization'
        && request.auth.uid == orgId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }

    // A quest series' cover-photo gallery (see add_quest_series_cover_photo/
    // remove_quest_series_cover_photo in functions/main.py and
    // CreateQuestForm.jsx) — an org can add as many as it wants. Same shape
    // as orgPhotos above — readable by anyone signed in (every quest list
    // that shows one needs it), writable only by the org uploading it,
    // always to a fresh {timestampMillis}.{ext} path. Keyed by the
    // uploading org's own uid, not the seriesId — the Cloud Functions above
    // are what actually enforce that org owns the series a given photo gets
    // pointed at, the same division of labor orgPhotos already draws
    // between "can this org write somewhere under its own prefix" (here)
    // and "is this org allowed to make this specific change" (the Cloud
    // Function).
    match /questCovers/{orgId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.role == 'organization'
        && request.auth.uid == orgId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }

    // A member's own profile picture (see update_user_profile in
    // functions/main.py and Profile.jsx's "Edit Profile"). Same shape as
    // orgPhotos above — a fresh {timestampMillis}.{ext} path each time
    // rather than overwriting, so the previous photo (however briefly)
    // isn't deleted out from under anything still displaying its URL.
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }

    // A member's own choice of background picture for one journal entry
    // (see set_journal_thumbnail in functions/main.py and Journal.jsx's
    // ThumbnailPicker). Same shape as avatars above — a fresh
    // {timestampMillis}.{ext} path each time.
    match /journalThumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }
  }
}
