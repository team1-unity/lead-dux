rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pulls the uid back out of a {questId}_{uid} composite id (see
    // photoSubmissions below) by taking the LAST '_'-separated segment, not
    // a fixed index — a quest id can itself contain underscores (seed data
    // uses slugs like "seed-jc-community-kitchen-near_full"), but a
    // Firebase Auth uid never does, so the final segment is always the uid
    // regardless of how many underscores came before it.
    function submitterUid(docId) {
      return docId.split('_')[docId.split('_').size() - 1];
    }

    // Every profile/request/config write in this app happens via a Cloud
    // Function (Admin SDK, bypasses these rules) — complete_signup,
    // submit_onboarding, approve_organization, set_user_role. Nothing here
    // accepts a direct client write; rules only gate reads.

    // Public user profile. Owner can read their own; an admin can read
    // anyone's (powers the admin dashboard's "view user" screen).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if false;

      // One entry per organization quest actually checked into — created
      // at check-in (see check_in_to_event), holding the leader's own
      // private reflection plus whatever requested feedback (see
      // request_quest_feedback/submit_feedback_request_response) has come
      // in for it, if any. Nothing sensitive here (unlike attendance
      // tokens), so — same as the parent doc — the owner can read it
      // directly; only a Cloud Function can write.
      match /journal/{questId} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
        allow write: if false;
      }

      // A transient popup notice — a quest they'd RSVP'd to was rescheduled
      // or cancelled (see update_quest/delete_quest* and dismiss_notification
      // in functions/main.py). No history kept once dismissed, unlike
      // journal above, so there's nothing here an admin needs to read either.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Pending organization signup request. Same read pattern as users/{uid}.
    match /ORGREQ/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if false;
    }

    // Approved organization profile. Publicly readable (within the app) to
    // any signed-in user, same as quests below — this is what backs the
    // Organization Profile page, and the doc has no field on it that isn't
    // meant to be public once an org is approved (see update_organization_
    // profile/approve_organization in functions/main.py).
    match /organizations/{uid} {
      allow read: if request.auth != null;
      allow write: if false;

      // The org's own private reflection on how hosting a specific
      // occurrence went — see submit_host_reflection in functions/main.py.
      // Nothing sensitive here, same as users/{uid}/feedback, so the
      // owner can read it directly; only a Cloud Function can write.
      match /hostReflections/{questId} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
        allow write: if false;
      }
    }

    // Any signed-in user can read the quest list to see it sorted by their
    // own interests client-side. No quest-authoring UI exists yet, so
    // there's no write path to allow. A quest's qrToken/qrTokenVersion
    // fields ride along on this same doc (see generate_event_qr_code) —
    // they're never read directly by a client either way, only ever
    // returned baked into a QR image over the callable-function channel,
    // same as the rest of this doc's write-only-via-Cloud-Function shape.
    //
    // `get` (a single doc by id) is additionally open to anyone at all,
    // signed in or not — this is what SharedQuest.jsx's public "Share
    // Quest" link relies on (see QuestSeriesRow.jsx's ShareQuestBox), the
    // one place in the app meant to work for a visitor with no account.
    // `list` (browsing/querying the whole collection) stays signed-in-only
    // so the full catalog isn't publicly crawlable — only a quest whose
    // exact id/seriesId someone already has (from a specific shared link)
    // is reachable this way.
    match /quests/{questId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if false;
    }

    // Attendance records — one per successful check-in (see
    // check_in_to_event in functions/main.py). An org still only sees who's
    // checked in via list_quest_attendees (Admin SDK) — this client-facing
    // read is scoped to the caller's own docs only, so Badges.jsx can query
    // `where('userId', '==', uid)` to compute completion-based badges
    // without a round trip through a Cloud Function.
    match /attendance/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.role == 'admin'
      );
      allow write: if false;
    }

    // Reviews and their aggregate rating live at the series level, not
    // under any one quest occurrence's own doc — a review left after
    // attending one date should still show up (and count toward the
    // rating) no matter which date in the series someone's looking at,
    // and it has to survive that original date later being deleted. See
    // submit_review in functions/main.py.
    match /questSeries/{seriesId} {
      // Just the aggregate reviewCount/avgRating — any signed-in user can
      // see a quest's rating while browsing, same as the quests collection.
      // Unlike quests/{questId}, SharedQuest.jsx's public link doesn't
      // read this doc (QuestDetailBody, which it reuses, doesn't render
      // the rating), so this stays signed-in-only rather than opening a
      // read path nothing actually uses yet.
      allow read: if request.auth != null;
      allow write: if false;

      // Full review text/rating. Only readable via list_quest_reviews
      // (owning org/admin) or get_my_review (the reviewer themselves) —
      // both go through the Admin SDK, so this stays denied here.
      match /reviews/{uid} {
        allow read, write: if false;
      }
    }

    // Photo submissions — proof of quest participation (see
    // submit_quest_photo/approve_photo_submission/reject_photo_submission
    // in functions/main.py). Doc id is {questId}_{uid} (_attendance_doc_id)
    // — the owner's own uid is parsed straight out of the id (see
    // submitterUid above), rather than read off resource.data. That's
    // deliberate: the client polls this doc BEFORE any submission exists
    // yet (to show the upload form), and `resource` is null for a
    // nonexistent doc — referencing resource.data.userId unconditionally
    // would make that very first read error out and deny, rather than
    // resolve to "no submission yet". The org branch still needs
    // resource.data.orgId (denormalized at submit time), so it's guarded
    // with `resource != null` first.
    match /photoSubmissions/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == submitterUid(docId) ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'organization' && resource != null && request.auth.uid == resource.data.orgId)
      );
      allow write: if false;
    }

    // Leader-requested feedback on a specific quest occurrence (see
    // request_quest_feedback/submit_feedback_request_response in
    // functions/main.py) — doc id is {questId}_{uid}, same convention and
    // same read shape as photoSubmissions above: the requesting leader,
    // the owning org, or an admin.
    match /feedbackRequests/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == submitterUid(docId) ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'organization' && resource != null && request.auth.uid == resource.data.orgId)
      );
      allow write: if false;
    }

    // Admin allowlist (config/admins) and anything else under config/ —
    // never exposed to any client, read internally by complete_signup only
    // (via the Admin SDK, which doesn't go through these rules at all).
    match /config/{document=**} {
      allow read, write: if false;
    }
  }
}
